+# R28: self-capture (repo == data root) excludes runs/ + metrics/ bookkeeping from diff.patch.
+Write-Host "`n[v1.1] R28 self-capture bookkeeping exclusion" -ForegroundColor Cyan
+if ($gitOk) {
+    $selfRoot = Join-Path $Sandbox "self-root"
