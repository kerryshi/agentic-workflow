+def test_kill_switch_engaged_refuses_the_run(dbpath, stop_path, capsys):
+    _seed(dbpath)
+    send.engage_stop("testing", stop_path)
+    rc = send.send_batch(
+        live=True,
+        settings=_settings(),
+        path=dbpath,
+        cap=5,
+        transport=_explode,
+        stop_path=stop_path,
+    )
+    out = capsys.readouterr().out
+
+    assert rc == 2
+    assert "kill switch engaged" in out
+    assert db.all_leads(dbpath)[0].status == Status.APPROVED
+
+
+def test_kill_switch_engaged_mid_batch_stops_the_rest(dbpath, stop_path, capsys):
+    # The switch is re-read before every message, so `stop` in another terminal
+    # halts a campaign already in flight.
+    _seed(dbpath, *[_approved(f"n/{i}") for i in range(5)])
+    rec = Recorder()
+
+    def stop_after_first(email):
+        rec(email)
+        send.engage_stop("pulled mid-batch", stop_path)
+
+    send.send_batch(
+        live=True,
+        settings=_settings(),
+        path=dbpath,
+        cap=5,
+        transport=stop_after_first,
+        stop_path=stop_path,
+    )
+
+    assert len(rec.sent) == 1  # the rest never went out
+    assert "KILL SWITCH engaged — aborting" in capsys.readouterr().out
+
+
+def test_stop_engage_and_release_roundtrip(stop_path):
+    assert send.stop_engaged(stop_path) is False
+    send.engage_stop("why", stop_path)
+    assert send.stop_engaged(stop_path) is True
+    assert send.release_stop(stop_path) is True
+    assert send.stop_engaged(stop_path) is False
+    assert send.release_stop(stop_path) is False  # releasing twice is a no-op
