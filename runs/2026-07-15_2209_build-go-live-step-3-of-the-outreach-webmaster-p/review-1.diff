 # Columns written/read for a Lead (excludes id/created_at/updated_at).
@@ -553,3 +569,84 @@ def is_dnc(value: str, path: Path = DEFAULT_DB) -> bool:
     with _connect(path) as conn:
         row = conn.execute("SELECT 1 FROM dnc WHERE value=?", (_dnc_norm(value),)).fetchone()
     return row is not None
+
+
+# --- the send ledger --------------------------------------------------------
+# Only the live send path writes here. Nothing in this section sends anything;
+# it is the record that makes a send idempotent and the daily cap truthful.
+
+SEND_CLAIMED = "claimed"
+SEND_SENT = "sent"
+SEND_FAILED = "failed"
+
+
+def _has_table(conn: sqlite3.Connection, name: str) -> bool:
+    row = conn.execute(
+        "SELECT 1 FROM sqlite_master WHERE type='table' AND name=?", (name,)
+    ).fetchone()
+    return row is not None
+
+
+def claim_send(
+    lead_id: int, to_email: str, subject: str | None = None, path: Path = DEFAULT_DB
+) -> bool:
+    """Reserve the right to send this lead exactly one email. True if we now own it.
+
+    This is the record-before-send atom: the caller MUST get True here before touching
+    SMTP, and must never transmit without it. `INSERT OR IGNORE` against UNIQUE(lead_id)
+    makes the claim a single atomic statement, so two concurrent runs — or a retry after
+    a crash that killed the process between claim and transmit — cannot both win it.
+    False means the lead was already claimed: skip it, do not re-send.
+    """
+    with _connect(path) as conn:
+        cur = conn.execute(
+            "INSERT OR IGNORE INTO sends (lead_id, to_email, subject) VALUES (?, ?, ?)",
+            (lead_id, to_email, subject),
+        )
+        return cur.rowcount > 0
+
+
+def mark_send(lead_id: int, state: str, path: Path = DEFAULT_DB) -> None:
+    """Record the outcome of a claimed send ('sent' or 'failed').
+
+    A 'failed' row deliberately KEEPS its claim: a lead whose send blew up mid-flight
+    may or may not have reached the recipient, so the safe reading is "do not try again
+    automatically". Clearing it is an operator decision.
+    """
+    with _connect(path) as conn:
+        conn.execute("UPDATE sends SET state=? WHERE lead_id=?", (str(state), lead_id))
+
+
+def sent_today_count(path: Path = DEFAULT_DB) -> int:
+    """Emails actually claimed/sent today (local date) — the real daily-cap counter.
+
+    Counts 'claimed' alongside 'sent' on purpose: a claim whose process died still may
+    have put a message on the wire, so it consumes a slot. The cap must err toward
+    under-sending, never over.
+
+    Returns 0 when the ledger table is absent: a DB predating the ledger has, by
+    definition, sent nothing through it. This is what lets the send stage compute a cap
+    on a legacy DB without `init_db` first — so a *dry-run* never has to migrate the
+    operator's database just to preview.
+    """
+    with _connect(path) as conn:
+        if not _has_table(conn, "sends"):
+            return 0
+        row = conn.execute(
+            "SELECT COUNT(*) AS n FROM sends WHERE state IN (?, ?) "
+            "AND date(created_at, 'localtime')=date('now', 'localtime')",
+            (SEND_CLAIMED, SEND_SENT),
+        ).fetchone()
+    return row["n"] if row else 0
+
+
+def send_state(lead_id: int, path: Path = DEFAULT_DB) -> str | None:
+    """The ledger state for a lead ('claimed' | 'sent' | 'failed'), or None if never claimed.
+
+    None on a pre-ledger DB, for the same reason as `sent_today_count`.
+    """
+    with _connect(path) as conn:
+        if not _has_table(conn, "sends"):
+            return None
+        row = conn.execute("SELECT state FROM sends WHERE lead_id=?", (lead_id,)).fetchone()
+    return row["state"] if row else None
