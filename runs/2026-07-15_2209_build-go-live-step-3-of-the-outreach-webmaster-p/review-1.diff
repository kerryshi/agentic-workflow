@@ -0,0 +1,36 @@
+"""Suite-wide safety net: no test may ever open an SMTP connection.
+
+The send stage is the one code path in this repo that can do irreversible damage to
+real businesses' inboxes (docs/GO-LIVE.md). Its no-send property is enforced in the
+code by three gates, but a test is exactly the place where someone constructs a config
+that satisfies all of them — so the guarantee must not rest on every future test author
+remembering to inject a fake transport.
+
+This fixture is autouse and unconditional: every SMTP entry point raises before it can
+resolve a hostname. An accidental real transport is therefore a loud test failure, not
+an outbound email.
+"""
+
+from __future__ import annotations
+
+import smtplib
+
+import pytest
+
+
+class SMTPSendAttemptedInTests(AssertionError):
+    """Raised when a test tries to open a real SMTP connection."""
+
+
+@pytest.fixture(autouse=True)
+def _no_real_smtp(monkeypatch):
+    """Poison every smtplib entry point for the whole suite."""
+
+    def _explode(*args, **kwargs):
+        raise SMTPSendAttemptedInTests(
+            "A test attempted a real SMTP connection. Tests must inject a fake "
+            "transport into send.send_batch(transport=...) — never open a socket."
+        )
+
+    monkeypatch.setattr(smtplib, "SMTP", _explode)
+    monkeypatch.setattr(smtplib, "SMTP_SSL", _explode)
