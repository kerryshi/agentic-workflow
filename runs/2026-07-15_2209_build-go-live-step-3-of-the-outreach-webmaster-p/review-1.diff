+def test_send_never_demotes_a_lead(dbpath, stop_path):
+    # A WON lead that somehow reaches the batch must not be walked back to SENT.
+    (lead_id,) = _seed(dbpath, _approved("n/1"))
+    db.set_status(lead_id, Status.WON, dbpath)
+    rec = Recorder()
+    send.send_batch(
+        live=True, settings=_settings(), path=dbpath, cap=5, transport=rec, stop_path=stop_path
+    )
+
+    assert rec.sent == []  # not APPROVED, so never selected
+    assert db.all_leads(dbpath)[0].status == Status.WON
