+def _smtp_transport(cfg: SendConfig) -> Callable[[Email], None]:
+    """Build the real SMTP transport. Only ever called once every gate has passed.
+
+    Kept behind a factory so `send_batch`'s dry-run path never constructs a connection
+    object at all — the no-send property is structural, not a branch we remembered to
+    take.
+    """
+
+    def transport(email: Email) -> None:
+        msg = EmailMessage()
+        msg["From"] = f"{cfg.sender_name} <{cfg.sender_email}>"
+        msg["To"] = email.to
+        msg["Subject"] = email.subject
+        msg.set_content(email.body)
+        with smtplib.SMTP(cfg.smtp_host, cfg.smtp_port) as conn:
+            conn.starttls()
+            conn.login(cfg.smtp_user, cfg.smtp_password)
+            conn.send_message(msg)
+
+    return transport
