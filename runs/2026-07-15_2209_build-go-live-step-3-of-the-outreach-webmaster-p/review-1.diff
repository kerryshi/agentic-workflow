+++ b/tests/test_send_live.py
@@ -0,0 +1,513 @@
+"""The live-send contract: the three gates, and the GO-LIVE step-3 checklist.
+
+Nothing here sends. Every test that exercises the permitted-live path injects a fake
+transport that records into a list, and `tests/conftest.py` poisons `smtplib.SMTP`
+suite-wide, so a real socket is a hard failure rather than an email.
+
+What these tests pin down (docs/GO-LIVE.md step 3):
+  - --live alone, or with partial env, or without --cap, never sends;
+  - dry-run never even calls a transport;
+  - a claim is recorded BEFORE transmission, so a crash cannot re-send on retry;
+  - the cap is counted from what was actually sent today, not from batch size;
+  - DNC is re-checked at send time, not just at selection;
+  - the status advance is forward-only;
+  - every transmitted body carries the CAN-SPAM footer;
+  - the kill switch stops a batch, including one already in flight.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from outreach_webmaster import db
+from outreach_webmaster.config import SendConfig, Settings
+from outreach_webmaster.models import Lead, Status
+from outreach_webmaster.outreach import send
+
+
+def _full_cfg(**over) -> SendConfig:
+    """A config where every live gate on the env is satisfied."""
+    base = dict(
+        subject_template="A quick idea for {business}",
+        sender_name="Kerry Shi",
+        sender_email="kerry@example.com",
+        sender_address="123 Main St, Austin, TX 78701",
+        smtp_host="smtp.example.com",
+        smtp_port=587,
+        smtp_user="kerry@example.com",
+        smtp_password="not-a-real-password",  # noqa: S106 — fake, never leaves the test
+    )
+    base.update(over)
+    return SendConfig(**base)
+
+
+def _settings(cfg: SendConfig | None = None, daily_send_cap: int = 20) -> Settings:
+    return Settings(
+        categories=[],
+        regions=[],
+        fit=None,
+        send=cfg or _full_cfg(),
+        daily_send_cap=daily_send_cap,
+    )
+
+
+def _approved(source_id: str, **over) -> Lead:
+    # The name must be unique per lead: upsert_lead dedupes on normalized
+    # name|city|state within a source, so same-named leads collapse to one row.
+    fields = dict(
+        source="overpass",
+        source_id=source_id,
+        name=f"Acme Dental {source_id}",
+        email=f"{source_id}@acme.test",
+        hook="Hi Acme Dental, I noticed your site isn't mobile-friendly.",
+        status=Status.APPROVED,
+    )
+    fields.update(over)
+    return Lead(**fields)
+
+
+@pytest.fixture
+def dbpath(tmp_path):
+    path = tmp_path / "leads.sqlite"
+    db.init_db(path)
+    return path
+
+
+@pytest.fixture
+def stop_path(tmp_path):
+    # Never the real data/STOP — tests must not touch the operator's kill switch.
+    return tmp_path / "STOP"
+
+
+def _seed(dbpath, *leads: Lead) -> list[int]:
+    return [db.upsert_lead(lead, dbpath) for lead in (leads or (_approved("n/1"),))]
+
+
+class Recorder:
+    """A fake transport. Records what it was handed; never opens a socket."""
+
+    def __init__(self, fail_on: str | None = None):
+        self.sent: list[send.Email] = []
+        self.fail_on = fail_on
+
+    def __call__(self, email: send.Email) -> None:
+        if self.fail_on and self.fail_on in email.to:
+            raise RuntimeError("simulated SMTP failure")
+        self.sent.append(email)
+
+
+def _explode(email):  # pragma: no cover - invoked only if a gate leaks
+    raise AssertionError(f"transport called when it must not be (to={email.to})")
+
+
+# --- gate 1+3: --live requires an explicit --cap -----------------------------
+
+
+def test_live_without_cap_sends_nothing(dbpath, stop_path, capsys):
+    _seed(dbpath)
+    rc = send.send_batch(
+        live=True, settings=_settings(), path=dbpath, transport=_explode, stop_path=stop_path
+    )
+    out = capsys.readouterr().out
+
+    assert rc == 2
+    assert "--cap N is required" in out
+    assert "DRY RUN" in out  # the preview still runs — it is diagnostic
+    assert db.all_leads(dbpath)[0].status == Status.APPROVED
+    assert db.sent_today_count(dbpath) == 0
+
+
+@pytest.mark.parametrize("cap", [0, -1])
+def test_live_with_nonpositive_cap_sends_nothing(dbpath, stop_path, capsys, cap):
+    _seed(dbpath)
+    rc = send.send_batch(
+        live=True,
+        settings=_settings(),
+        path=dbpath,
+        cap=cap,
+        transport=_explode,
+        stop_path=stop_path,
+    )
+
+    assert rc == 2
+    assert "--cap must be a positive integer" in capsys.readouterr().out
+    assert db.all_leads(dbpath)[0].status == Status.APPROVED
+
+
+# --- gate 2: the env config must be COMPLETE ---------------------------------
+
+
+@pytest.mark.parametrize(
+    "field,label",
+    [
+        ("smtp_host", "SMTP_HOST"),
+        ("smtp_user", "SMTP_USER"),
+        ("smtp_password", "SMTP_PASSWORD"),
+        ("sender_email", "SENDER_EMAIL"),
+        ("sender_name", "SENDER_NAME"),
+        ("sender_address", "SENDER_ADDRESS"),
+    ],
+)
+def test_live_with_any_env_piece_missing_sends_nothing(dbpath, stop_path, capsys, field, label):
+    # Every single field is load-bearing: a partial pass that crashes mid-batch is
+    # worse than no gate, because part of the batch has already hit real inboxes.
+    _seed(dbpath)
+    cfg = _full_cfg(**{field: None})
+    rc = send.send_batch(
+        live=True,
+        settings=_settings(cfg),
+        path=dbpath,
+        cap=5,
+        transport=_explode,
+        stop_path=stop_path,
+    )
+    out = capsys.readouterr().out
+
+    assert rc == 2
+    assert "incomplete env config" in out
+    assert label in out  # names the specific missing var
+    assert db.all_leads(dbpath)[0].status == Status.APPROVED
+
+
+def test_missing_for_live_flags_nonpositive_port():
+    assert "SMTP_PORT" in send.missing_for_live(_full_cfg(smtp_port=0))
+    assert "SMTP_PORT" not in send.missing_for_live(_full_cfg())
+
+
+def test_live_blockers_empty_when_all_gates_pass(tmp_path):
+    assert send.live_blockers(_full_cfg(), cap=5, stop_path=tmp_path / "STOP") == []
+
+
+# --- legacy DBs (created before the send ledger existed) ---------------------
+
+
+def _drop_sends(path):
+    """Recreate the pre-ledger schema: a DB from before `sends` existed."""
+    import sqlite3
+
+    with sqlite3.connect(path) as conn:
+        conn.execute("DROP TABLE sends")
+
+
+def test_dry_run_works_on_a_db_without_the_send_ledger(dbpath, stop_path, capsys):
+    # Regression: the cap is computed (and so the ledger read) on EVERY run, including
+    # dry-run, but the ledger table only appears once init_db has migrated the DB. On a
+    # real pre-2026-07-16 DB that made a plain dry-run crash with "no such table: sends".
+    _seed(dbpath)
+    _drop_sends(dbpath)
+
+    rc = send.send_batch(live=False, settings=_settings(), path=dbpath, stop_path=stop_path)
+    out = capsys.readouterr().out
+
+    assert rc == 0
+    assert "DRY RUN" in out
+    assert db.all_leads(dbpath)[0].status == Status.APPROVED
+
+
+def test_live_refusal_works_on_a_db_without_the_send_ledger(dbpath, stop_path, capsys):
+    # Same path, but the operator asked for --live: it must still reach the gate
+    # refusal (exit 2), not die on the missing table first.
+    _seed(dbpath)
+    _drop_sends(dbpath)
+
+    rc = send.send_batch(
+        live=True, settings=_settings(), path=dbpath, transport=_explode, stop_path=stop_path
+    )
+
+    assert rc == 2
+    assert "--cap N is required" in capsys.readouterr().out
+
+
+def test_sent_today_count_is_zero_without_the_ledger(dbpath):
+    _drop_sends(dbpath)
+    assert db.sent_today_count(dbpath) == 0
+
+
+def test_live_send_migrates_a_legacy_db_and_sends(dbpath, stop_path):
+    # The live path creates the ledger before it claims anything, so a legacy DB
+    # still sends correctly once every gate passes.
+    (lead_id,) = _seed(dbpath)
+    _drop_sends(dbpath)
+    rec = Recorder()
+
+    rc = send.send_batch(
+        live=True, settings=_settings(), path=dbpath, cap=5, transport=rec, stop_path=stop_path
+    )
+
+    assert rc == 0
+    assert [e.to for e in rec.sent] == ["n/1@acme.test"]
+    assert db.send_state(lead_id, dbpath) == db.SEND_SENT
+
+
+# --- the dry-run default never reaches a transport ---------------------------
+
+
+def test_dry_run_never_calls_transport(dbpath, stop_path, capsys):
+    _seed(dbpath)
+    rc = send.send_batch(
+        live=False, settings=_settings(), path=dbpath, transport=_explode, stop_path=stop_path
+    )
+    out = capsys.readouterr().out
+
+    assert rc == 0
+    assert "DRY RUN" in out
+    assert "Nothing was sent" in out
+    assert db.all_leads(dbpath)[0].status == Status.APPROVED
+    assert db.sent_today_count(dbpath) == 0
+
+
+def test_dry_run_is_the_default_even_with_full_config(dbpath, stop_path):
+    # No `live=` argument at all — the default must be the safe one.
+    _seed(dbpath)
+    rc = send.send_batch(
+        settings=_settings(), path=dbpath, cap=5, transport=_explode, stop_path=stop_path
+    )
+    assert rc == 0
+    assert db.all_leads(dbpath)[0].status == Status.APPROVED
+
+
+# --- all gates pass: it actually sends --------------------------------------
+
+
+def test_all_gates_pass_sends_and_advances_status(dbpath, stop_path, capsys):
+    (lead_id,) = _seed(dbpath)
+    rec = Recorder()
+    rc = send.send_batch(
+        live=True,
+        settings=_settings(),
+        path=dbpath,
+        cap=5,
+        transport=rec,
+        stop_path=stop_path,
+    )
+    out = capsys.readouterr().out
+
+    assert rc == 0
+    assert [e.to for e in rec.sent] == ["n/1@acme.test"]
+    assert "LIVE" in out
+    assert db.all_leads(dbpath)[0].status == Status.SENT
+    assert db.send_state(lead_id, dbpath) == db.SEND_SENT
+    assert db.sent_today_count(dbpath) == 1
+
+
+def test_every_sent_body_carries_the_can_spam_footer(dbpath, stop_path):
+    # GO-LIVE step 3: "The CAN-SPAM footer on every email — assert it in a test."
+    _seed(dbpath, _approved("n/1"), _approved("n/2"), _approved("n/3"))
+    rec = Recorder()
+    send.send_batch(
+        live=True,
+        settings=_settings(),
+        path=dbpath,
+        cap=5,
+        transport=rec,
+        stop_path=stop_path,
+    )
+
+    assert len(rec.sent) == 3
+    for email in rec.sent:
+        assert send.OPT_OUT_LINE in email.body  # opt-out
+        assert "123 Main St, Austin, TX 78701" in email.body  # physical address
+        assert "Kerry Shi" in email.body  # sender identity
+
+
+# --- idempotency: a claim is recorded before the socket opens ---------------
+
+
+def test_second_run_resends_nothing(dbpath, stop_path):
+    _seed(dbpath)
+    first = Recorder()
+    send.send_batch(
+        live=True, settings=_settings(), path=dbpath, cap=5, transport=first, stop_path=stop_path
+    )
+    second = Recorder()
+    send.send_batch(
+        live=True, settings=_settings(), path=dbpath, cap=5, transport=second, stop_path=stop_path
+    )
+
+    assert len(first.sent) == 1
+    assert second.sent == []  # the ledger claim blocks it
+
+
+def test_crash_mid_batch_does_not_resend_on_retry(dbpath, stop_path):
+    # The claim is written BEFORE transmission, so a lead whose send blew up is not
+    # retried: we cannot know whether it reached the wire.
+    (lead_id,) = _seed(dbpath)
+    crashed = Recorder(fail_on="n/1@acme.test")
+    rc = send.send_batch(
+        live=True, settings=_settings(), path=dbpath, cap=5, transport=crashed, stop_path=stop_path
+    )
+
+    assert rc == 1  # transmission errors
+    assert crashed.sent == []
+    assert db.send_state(lead_id, dbpath) == db.SEND_FAILED
+    assert db.all_leads(dbpath)[0].status == Status.APPROVED  # never advanced
+
+    retry = Recorder()
+    send.send_batch(
+        live=True, settings=_settings(), path=dbpath, cap=5, transport=retry, stop_path=stop_path
+    )
+    assert retry.sent == []  # the claim survives the failure
+
+
+def test_claim_send_is_atomic(dbpath):
+    (lead_id,) = _seed(dbpath)
+    assert db.claim_send(lead_id, "a@b.test", "s", dbpath) is True
+    assert db.claim_send(lead_id, "a@b.test", "s", dbpath) is False  # only one winner
+
+
+# --- the cap is counted from what actually went out today -------------------
+
+
+def test_effective_cap_is_min_of_run_cap_and_daily_cap(dbpath, stop_path):
+    _seed(dbpath, *[_approved(f"n/{i}") for i in range(10)])
+    rec = Recorder()
+    send.send_batch(
+        live=True,
+        settings=_settings(daily_send_cap=3),  # config cap is the tighter one
+        path=dbpath,
+        cap=8,
+        transport=rec,
+        stop_path=stop_path,
+    )
+    assert len(rec.sent) == 3
+
+
+def test_run_cap_wins_when_tighter(dbpath, stop_path):
+    _seed(dbpath, *[_approved(f"n/{i}") for i in range(10)])
+    rec = Recorder()
+    send.send_batch(
+        live=True, settings=_settings(daily_send_cap=20), path=dbpath, cap=2, transport=rec,
+        stop_path=stop_path,
+    )
+    assert len(rec.sent) == 2
+
+
+def test_cap_counts_what_was_already_sent_today(dbpath, stop_path):
+    # Two runs in one day must not each get a full cap.
+    _seed(dbpath, *[_approved(f"n/{i}") for i in range(10)])
+    first = Recorder()
+    send.send_batch(
+        live=True, settings=_settings(daily_send_cap=5), path=dbpath, cap=5, transport=first,
+        stop_path=stop_path,
+    )
+    assert len(first.sent) == 5
+
+    second = Recorder()
+    send.send_batch(
+        live=True, settings=_settings(daily_send_cap=5), path=dbpath, cap=5, transport=second,
+        stop_path=stop_path,
+    )
+    assert second.sent == []  # today's allowance is spent
+    assert db.sent_today_count(dbpath) == 5
+
+
+# --- DNC is re-checked at send time -----------------------------------------
+
+
+def test_dnc_registered_after_selection_is_honored(dbpath, stop_path, capsys):
+    # The real race GO-LIVE calls out: both leads are clean at triage, then an
+    # unsubscribe for n/2 lands while n/1 is being sent. Only a re-check at send
+    # time can catch that — selection already passed n/2 through.
+    ids = _seed(dbpath, _approved("n/1"), _approved("n/2"))
+    rec = Recorder()
+
+    def unsubscribe_mid_batch(email):
+        rec(email)  # n/1 goes out first...
+        db.add_dnc("n/2@acme.test", "replied unsubscribe", dbpath)  # ...then n/2 opts out
+
+    rc = send.send_batch(
+        live=True,
+        settings=_settings(),
+        path=dbpath,
+        cap=5,
+        transport=unsubscribe_mid_batch,
+        stop_path=stop_path,
+    )
+    out = capsys.readouterr().out
+
+    assert rc == 0
+    assert [e.to for e in rec.sent] == ["n/1@acme.test"]  # n/2 was spared
+    assert "on do-not-contact as of now" in out
+    assert db.send_state(ids[1], dbpath) is None  # never claimed, never sent
+    assert db.all_leads(dbpath)[1].status == Status.APPROVED
+
+
+def test_dnc_lead_is_never_claimed(dbpath, stop_path):
+    ids = _seed(dbpath, _approved("n/1"), _approved("n/2"))
+    db.add_dnc("n/2@acme.test", "opted out", dbpath)
+    rec = Recorder()
+    send.send_batch(
+        live=True, settings=_settings(), path=dbpath, cap=5, transport=rec, stop_path=stop_path
+    )
+
+    assert [e.to for e in rec.sent] == ["n/1@acme.test"]
+    assert db.send_state(ids[1], dbpath) is None  # never even claimed
+
