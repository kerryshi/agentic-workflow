+    [string]$FollowUps = "",
+
+    [string[]]$FilesChanged = @(),
+
+    [string[]]$EvidenceLinks = @(),
+
+    [string]$Repo = "",
+
+    [switch]$CaptureDiff
+)
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = "Stop"
+
+function Get-GitFilesChanged {
+    param([Parameter(Mandatory = $true)][string]$RepoPath)
+
+    $allFiles = @()
+    try {
+        $statusLines = & git -C $RepoPath status --porcelain=v1 2>$null
+        foreach ($line in @($statusLines)) {
+            if ([string]::IsNullOrWhiteSpace($line) -or $line.Length -lt 4) {
+                continue
+            }
+            $path = $line.Substring(3).Trim()
+            if ($path -match " -> ") {
+                $path = @($path -split " -> ")[-1]
+            }
+            $path = $path.Trim('"')
+            if (-not [string]::IsNullOrWhiteSpace($path)) {
+                $allFiles += $path
+            }
+        }
+    }
+    catch {
+    }
+
+    # Fallback for older Git/status edge cases.
+    try {
+        $untracked = & git -C $RepoPath ls-files --others --exclude-standard 2>$null
+        $allFiles += @($untracked | Where-Object { -not [string]::IsNullOrWhiteSpace($_) })
+    }
+    catch {
+    }
+
+    return @($allFiles | Sort-Object -Unique)
+}
+
+function Get-GitBranch {
+    param([Parameter(Mandatory = $true)][string]$RepoPath)
+
+    try {
+        $branchName = & git -C $RepoPath rev-parse --abbrev-ref HEAD 2>$null | Select-Object -First 1
+        if ($LASTEXITCODE -eq 0 -and -not [string]::IsNullOrWhiteSpace($branchName)) {
+            return $branchName.Trim()
+        }
+    }
+    catch {
+        return ""
+    }
+    return ""
+}
+
+function Get-GitStatusEntries {
+    param([Parameter(Mandatory = $true)][string]$RepoPath)
+
+    $entries = @()
+    try {
+        $statusLines = & git -C $RepoPath status --porcelain=v1 2>$null
+        foreach ($line in @($statusLines)) {
+            if ([string]::IsNullOrWhiteSpace($line) -or $line.Length -lt 4) {
+                continue
+            }
+            $code = $line.Substring(0, 2)
+            $path = $line.Substring(3).Trim()
+            if ($path -match " -> ") {
+                $path = @($path -split " -> ")[-1]
+            }
+            $path = $path.Trim('"')
+            if (-not [string]::IsNullOrWhiteSpace($path)) {
+                $entries += [pscustomobject]@{
+                    Code = $code
+                    Path = $path
+                }
+            }
+        }
+    }
+    catch {
+    }
+    return $entries
+}
+
+function New-UntrackedFilePatch {
+    param(
+        [Parameter(Mandatory = $true)][string]$RepoPath,
+        [Parameter(Mandatory = $true)][string]$RelativePath
+    )
+
+    $fullPath = Join-Path $RepoPath $RelativePath
+    if (-not (Test-Path -LiteralPath $fullPath -PathType Leaf)) {
+        return ("# Untracked non-file path: {0}" -f $RelativePath)
+    }
+
+    $bytes = [System.IO.File]::ReadAllBytes($fullPath)
+    if ($bytes -contains 0) {
+        return ("# Binary untracked file omitted from text patch: {0}" -f $RelativePath)
+    }
+
+    $path = $RelativePath.Replace("\", "/")
+    $content = Get-Content -Raw -LiteralPath $fullPath -Encoding UTF8
+    $lines = @()
+    if (-not [string]::IsNullOrEmpty($content)) {
+        $lines = $content -split "`r?`n"
+        if ($lines.Count -gt 0 -and $lines[$lines.Count - 1] -eq "") {
+            $lines = $lines[0..($lines.Count - 2)]
+        }
+    }
+
+    $patch = @(
+        ("diff --git a/{0} b/{0}" -f $path),
+        "new file mode 100644",
+        "index 0000000..0000000",
+        "--- /dev/null",
+        ("+++ b/{0}" -f $path),
+        ("@@ -0,0 +1,{0} @@" -f $lines.Count)
+    )
+    foreach ($line in $lines) {
+        $patch += ("+{0}" -f $line)
+    }
+    return ($patch -join "`r`n")
+}
+
+function Get-GitDiff {
+    param([Parameter(Mandatory = $true)][string]$RepoPath)
+
+    $parts = @()
+    try {
+        $diff = & git -C $RepoPath diff --binary HEAD 2>$null
+        $trackedDiff = ($diff -join "`r`n")
+        if (-not [string]::IsNullOrWhiteSpace($trackedDiff)) {
+            $parts += $trackedDiff
+        }
+    }
+    catch {
+    }
+
+    if ($parts.Count -eq 0) {
+        $trackedEntries = @(Get-GitStatusEntries $RepoPath | Where-Object { $_.Code -ne "??" })
+        foreach ($entry in $trackedEntries) {
+            try {
+                $fileDiff = & git -C $RepoPath diff --binary HEAD -- $entry.Path 2>$null
+                $fileText = ($fileDiff -join "`r`n")
+                if (-not [string]::IsNullOrWhiteSpace($fileText)) {
+                    $parts += $fileText
+                }
+            }
+            catch {
+            }
+        }
+    }
+
+    try {
+        $untracked = & git -C $RepoPath ls-files --others --exclude-standard 2>$null
+        foreach ($file in @($untracked)) {
+            if ([string]::IsNullOrWhiteSpace($file)) {
+                continue
+            }
+            if ($file.Replace("\", "/") -like "runs/*/diff.patch") {
+                continue
+            }
+            $newFileText = New-UntrackedFilePatch -RepoPath $RepoPath -RelativePath $file
+            if (-not [string]::IsNullOrWhiteSpace($newFileText)) {
+                $parts += $newFileText
+            }
+        }
+    }
+    catch {
+    }
+
+    return ($parts -join "`r`n`r`n")
+}
+
+$scriptDir = Split-Path -Parent $PSCommandPath
+$root = Split-Path -Parent $scriptDir
+$runDir = Join-Path (Join-Path $root "runs") $RunId
+$runJson = Join-Path $runDir "run.json"
+$metricsDir = Join-Path $root "metrics"
+
+if (-not (Test-Path -LiteralPath $runJson)) {
+    throw "Run not found: $RunId"
+}
+
+New-Item -ItemType Directory -Force -Path $metricsDir | Out-Null
+
+$run = Get-Content -Raw -LiteralPath $runJson | ConvertFrom-Json
+if ([string]::IsNullOrWhiteSpace($Repo)) {
+    $Repo = $run.repo
+}
+$repoPath = $Repo.Replace("/", "\")
+
+$completedAt = Get-Date -Format "yyyy-MM-ddTHH:mm:sszzz"
+$run.status = $Status
+$run.completed_at = $completedAt
+if (([string]::IsNullOrWhiteSpace([string]$run.branch) -or $run.branch -eq "unknown") -and (Test-Path -LiteralPath $repoPath)) {
+    $detectedBranch = Get-GitBranch $repoPath
+    if (-not [string]::IsNullOrWhiteSpace($detectedBranch)) {
+        $run.branch = $detectedBranch
+    }
+}
+if (-not [string]::IsNullOrWhiteSpace($FinalOutcome)) {
+    $run.final_outcome = $FinalOutcome
+}
+if (-not [string]::IsNullOrWhiteSpace($ReviewerResult)) {
+    $run.reviewer_result = $ReviewerResult
+}
+
+$changedFiles = @($FilesChanged | Where-Object { -not [string]::IsNullOrWhiteSpace($_) })
+if ($changedFiles.Count -eq 0 -and -not [string]::IsNullOrWhiteSpace($repoPath) -and (Test-Path -LiteralPath $repoPath)) {
+    $changedFiles = Get-GitFilesChanged $repoPath
+}
+$run.files_changed = $changedFiles
+$run.evidence_links = @($EvidenceLinks)
+
+($run | ConvertTo-Json -Depth 8) | Set-Content -LiteralPath $runJson -Encoding UTF8
+
+$evidenceLinksMarkdown = if (@($EvidenceLinks).Count -gt 0) {
+    (@($EvidenceLinks) | ForEach-Object { "- {0}" -f $_ }) -join "`r`n"
+}
+else {
+    "- TBD"
+}
+
+@"
+# Evidence
+
+## Summary
+$Evidence
+
+## Links
+$evidenceLinksMarkdown
+
+## Captured At
+$completedAt
+"@ | Set-Content -LiteralPath (Join-Path $runDir "evidence.md") -Encoding UTF8
+
+@"
+# Review
+
+## Independent Reviewer Result
+$ReviewerResult
+
+## Remaining Items
+TBD
+"@ | Set-Content -LiteralPath (Join-Path $runDir "review.md") -Encoding UTF8
+
+$filesMarkdown = if ($changedFiles.Count -gt 0) {
+    ($changedFiles | ForEach-Object { "- {0}" -f $_ }) -join "`r`n"
+}
+else {
+    "- TBD"
+}
+
+@"
+# Final
+
+## Outcome
+$FinalOutcome
+
+## Status
+$Status
+
+## Files Changed
+$filesMarkdown
+
+## Validation / Evidence
+$Evidence
+
+## Reviewer Result
+$ReviewerResult
+
+## Risks
+$Risks
+
+## Follow-ups
+$FollowUps
+"@ | Set-Content -LiteralPath (Join-Path $runDir "final.md") -Encoding UTF8
+
+if ($CaptureDiff -and -not [string]::IsNullOrWhiteSpace($repoPath) -and (Test-Path -LiteralPath $repoPath)) {
+    $diffText = Get-GitDiff $repoPath
+    $diffText | Set-Content -LiteralPath (Join-Path $runDir "diff.patch") -Encoding UTF8
+}
+
+$event = [ordered]@{
+    type = "run_completed"
+    at = $completedAt
+    run_id = $RunId
+    status = $Status
+    repo = $run.repo
+}
+$eventLine = $event | ConvertTo-Json -Compress -Depth 5
+Add-Content -LiteralPath (Join-Path $metricsDir "runs.jsonl") -Value $eventLine -Encoding UTF8
+
+Write-Output ("Completed run: {0} ({1})" -f $RunId, $Status)
+Write-Output $runDir

