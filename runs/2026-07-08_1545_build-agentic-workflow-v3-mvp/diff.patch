@@ -0,0 +1,246 @@
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory = $true)]
+    [string]$Summary,
+
+    [Parameter(Mandatory = $true)]
+    [ValidateSet(
+        "bad_context",
+        "bad_plan",
+        "wrong_file_edited",
+        "syntax_type_error",
+        "test_failure",
+        "hallucinated_api",
+        "unsafe_command",
+        "weak_verification",
+        "user_intent_misunderstood",
+        "tool_error",
+        "environment_platform_issue",
+        "permission_issue",
+        "shortcut_gamed_check",
+        "regression_introduced"
+    )]
+    [string]$FailureClass,
+
+    [ValidateSet("must_fix", "should_fix", "escaped_bug", "blocker", "note")]
+    [string]$Severity = "must_fix",
+
+    [string]$LinkedRun = "",
+
+    [string]$Repo = (Get-Location).Path,
+
+    [string]$CommitOrBranch = "",
+
+    [string]$ReproCommand = "",
+
+    [string]$Expected = "",
+
+    [string]$Actual = "",
+
+    [string]$PreventionLayer = "",
+
+    [ValidateSet("windows", "wsl", "mac")]
+    [string]$Machine = "windows"
+)
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = "Stop"
+
+function New-Slug {
+    param([Parameter(Mandatory = $true)][string]$Text)
+
+    $slug = [regex]::Replace($Text.ToLowerInvariant(), "[^a-z0-9]+", "-").Trim("-")
+    if ($slug.Length -gt 48) {
+        $slug = $slug.Substring(0, 48).Trim("-")
+    }
+    if ([string]::IsNullOrWhiteSpace($slug)) {
+        return "failure"
+    }
+    return $slug
+}
+
+function ConvertTo-RepoPath {
+    param([Parameter(Mandatory = $true)][string]$Path)
+
+    if (Test-Path -LiteralPath $Path) {
+        return (Resolve-Path -LiteralPath $Path).Path
+    }
+    return $Path
+}
+
+function Get-GitRef {
+    param([Parameter(Mandatory = $true)][string]$RepoPath)
+
+    try {
+        $ref = & git -C $RepoPath rev-parse --abbrev-ref HEAD 2>$null | Select-Object -First 1
+        if ($LASTEXITCODE -eq 0 -and -not [string]::IsNullOrWhiteSpace($ref)) {
+            return $ref.Trim()
+        }
+    }
+    catch {
+        return ""
+    }
+    return ""
+}
+
+$scriptDir = Split-Path -Parent $PSCommandPath
+$root = Split-Path -Parent $scriptDir
+$failuresDir = Join-Path $root "failures"
+$metricsDir = Join-Path $root "metrics"
+New-Item -ItemType Directory -Force -Path $failuresDir, $metricsDir | Out-Null
+
+$caseNumbers = @()
+Get-ChildItem -LiteralPath $failuresDir -Directory -Filter "CASE-*" -ErrorAction SilentlyContinue | ForEach-Object {
+    if ($_.Name -match "^CASE-(\d{4})") {
+        $caseNumbers += [int]$Matches[1]
+    }
+}
+$nextNumber = 1
+if ($caseNumbers.Count -gt 0) {
+    $nextNumber = (($caseNumbers | Measure-Object -Maximum).Maximum + 1)
+}
+
+$caseId = "CASE-{0:D4}" -f $nextNumber
+$caseDirName = "{0}_{1}" -f $caseId, (New-Slug $Summary)
+$caseDir = Join-Path $failuresDir $caseDirName
+New-Item -ItemType Directory -Force -Path $caseDir | Out-Null
+
+$repoPath = ConvertTo-RepoPath $Repo
+if ([string]::IsNullOrWhiteSpace($CommitOrBranch)) {
+    $CommitOrBranch = Get-GitRef $repoPath
+}
+if ([string]::IsNullOrWhiteSpace($CommitOrBranch)) {
+    $CommitOrBranch = "unknown"
+}
+
+$createdAt = Get-Date -Format "yyyy-MM-ddTHH:mm:sszzz"
+$repoName = Split-Path -Leaf $repoPath
+$failureData = [ordered]@{
+    case_id = $caseId
+    created_at = $createdAt
+    machine = $Machine
+    linked_run = $LinkedRun
+    repo = $repoPath.Replace("\", "/")
+    repo_name = $repoName
+    commit_or_branch = $CommitOrBranch
+    summary = $Summary
+    failure_class = $FailureClass
+    severity = $Severity
+    repro_command = $ReproCommand
+    status = "open"
+    prevention_layer = $(if ([string]::IsNullOrWhiteSpace($PreventionLayer)) { $null } else { $PreventionLayer })
+    regression_test = $null
+}
+
+($failureData | ConvertTo-Json -Depth 8) | Set-Content -LiteralPath (Join-Path $caseDir "failure.json") -Encoding UTF8
+
+@"
+# Prompt / Situation
+
+$Summary
+
+## Linked Run
+$LinkedRun
+
+## Repo
+- Machine: $Machine
+- Path: $repoPath
+- Commit/branch: $CommitOrBranch
+"@ | Set-Content -LiteralPath (Join-Path $caseDir "prompt.md") -Encoding UTF8
+
+@"
+# Expected Behavior
+
+$(if ([string]::IsNullOrWhiteSpace($Expected)) { "TBD" } else { $Expected })
+"@ | Set-Content -LiteralPath (Join-Path $caseDir "expected.md") -Encoding UTF8
+
+@"
+# Actual Behavior
+
+$(if ([string]::IsNullOrWhiteSpace($Actual)) { "TBD" } else { $Actual })
+"@ | Set-Content -LiteralPath (Join-Path $caseDir "actual.md") -Encoding UTF8
+
+@"
+# Reproduction
+
+## Command
+
+```powershell
+$ReproCommand
+```
+
+## Manual Steps
+- TBD
+"@ | Set-Content -LiteralPath (Join-Path $caseDir "repro.md") -Encoding UTF8
+
+@"
+# Classification
+
+- Failure class: $FailureClass
+- Severity: $Severity
+- Prevention layer: $(if ([string]::IsNullOrWhiteSpace($PreventionLayer)) { "TBD" } else { $PreventionLayer })
+
+## Root Cause
+TBD
+
+## Contributing Factors
+- TBD
+"@ | Set-Content -LiteralPath (Join-Path $caseDir "classification.md") -Encoding UTF8
+
+@"
+# Fix
+
+## Proposed Fix
+TBD
+
+## Applied Fix
+TBD
+
+## Verification
+TBD
+"@ | Set-Content -LiteralPath (Join-Path $caseDir "fix.md") -Encoding UTF8
+
+@"
+# Regression
+
+## Regression Test
+TBD
+
+## Failing-First Evidence
+TBD
+
+## Passing Evidence
+TBD
+"@ | Set-Content -LiteralPath (Join-Path $caseDir "regression.md") -Encoding UTF8
+
+if (-not [string]::IsNullOrWhiteSpace($LinkedRun)) {
+    $runJson = Join-Path (Join-Path $root "runs") (Join-Path $LinkedRun "run.json")
+    if (Test-Path -LiteralPath $runJson) {
+        $run = Get-Content -Raw -LiteralPath $runJson | ConvertFrom-Json
+        $linkedFailures = @()
+        if ($null -ne $run.linked_failures) {
+            $linkedFailures = @($run.linked_failures)
+        }
+        if ($linkedFailures -notcontains $caseId) {
+            $linkedFailures += $caseId
+        }
+        $run.linked_failures = $linkedFailures
+        ($run | ConvertTo-Json -Depth 8) | Set-Content -LiteralPath $runJson -Encoding UTF8
+    }
+}
+
+$event = [ordered]@{
+    type = "failure_captured"
+    at = $createdAt
+    case_id = $caseId
+    linked_run = $LinkedRun
+    failure_class = $FailureClass
+    severity = $Severity
+    repo = $repoPath.Replace("\", "/")
+}
+$eventLine = $event | ConvertTo-Json -Compress -Depth 5
+Add-Content -LiteralPath (Join-Path $metricsDir "runs.jsonl") -Value $eventLine -Encoding UTF8
+
+Write-Output ("Created failure case: {0}" -f $caseId)
+Write-Output $caseDir
+

