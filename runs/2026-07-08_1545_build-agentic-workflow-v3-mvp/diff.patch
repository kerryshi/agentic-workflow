+
+    [ValidateSet("shipped", "complete", "blocked", "abandoned")]
+    [string]$Status = "shipped",
+
+    [string]$FinalOutcome = "",
+
+    [string]$ReviewerResult = "",
+
+    [string]$Evidence = "",
