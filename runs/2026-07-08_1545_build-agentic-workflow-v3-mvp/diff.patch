diff --git a/scripts/summarize_metrics.ps1 b/scripts/summarize_metrics.ps1
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/scripts/summarize_metrics.ps1
@@ -0,0 +1,148 @@
+[CmdletBinding()]
+param(
+    [switch]$Json
+)
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = "Stop"
+
+function Read-JsonFiles {
+    param(
+        [Parameter(Mandatory = $true)][string]$Directory,
+        [Parameter(Mandatory = $true)][string]$FileName
+    )
+
+    $items = @()
+    if (-not (Test-Path -LiteralPath $Directory)) {
+        return $items
+    }
+
+    Get-ChildItem -LiteralPath $Directory -Directory -ErrorAction SilentlyContinue | ForEach-Object {
+        $path = Join-Path $_.FullName $FileName
+        if (Test-Path -LiteralPath $path) {
+            try {
+                $items += (Get-Content -Raw -LiteralPath $path | ConvertFrom-Json)
+            }
+            catch {
+                Write-Warning ("Skipping invalid JSON: {0}" -f $path)
+            }
+        }
+    }
+    return $items
+}
+
+function Get-ArrayCount {
+    param($Value)
+
+    if ($null -eq $Value) {
+        return 0
+    }
+    return @($Value).Count
+}
+
+$scriptDir = Split-Path -Parent $PSCommandPath
+$root = Split-Path -Parent $scriptDir
+$runsDir = Join-Path $root "runs"
+$failuresDir = Join-Path $root "failures"
+$metricsDir = Join-Path $root "metrics"
+New-Item -ItemType Directory -Force -Path $metricsDir | Out-Null
+
+$runs = @(Read-JsonFiles -Directory $runsDir -FileName "run.json")
+$failures = @(Read-JsonFiles -Directory $failuresDir -FileName "failure.json")
+
+$runCount = $runs.Count
+$shippedRuns = @($runs | Where-Object { $_.status -in @("shipped", "complete") }).Count
+$failedRuns = @($runs | Where-Object { (Get-ArrayCount $_.linked_failures) -gt 0 }).Count
+$openFailures = @($failures | Where-Object { $_.status -eq "open" }).Count
+$regressionsAdded = @($failures | Where-Object { -not [string]::IsNullOrWhiteSpace([string]$_.regression_test) }).Count
+$runsWithEvidence = @($runs | Where-Object { (Get-ArrayCount $_.evidence_links) -gt 0 -or $_.status -in @("shipped", "complete") }).Count
+$evidenceRate = 0
+if ($runCount -gt 0) {
+    $evidenceRate = [math]::Round(($runsWithEvidence / $runCount) * 100, 1)
+}
+
+$durations = @()
+foreach ($run in $runs) {
+    if (-not [string]::IsNullOrWhiteSpace([string]$run.created_at) -and -not [string]::IsNullOrWhiteSpace([string]$run.completed_at)) {
+        try {
+            $start = [datetimeoffset]::Parse([string]$run.created_at)
+            $end = [datetimeoffset]::Parse([string]$run.completed_at)
+            $durations += ($end - $start).TotalMinutes
+        }
+        catch {
+        }
+    }
+}
+$averageMinutes = $null
+if ($durations.Count -gt 0) {
+    $averageMinutes = [math]::Round((($durations | Measure-Object -Average).Average), 1)
+}
+
+$classCounts = @{}
+foreach ($failure in $failures) {
+    $class = [string]$failure.failure_class
+    if ([string]::IsNullOrWhiteSpace($class)) {
+        $class = "unclassified"
+    }
+    if (-not $classCounts.ContainsKey($class)) {
+        $classCounts[$class] = 0
+    }
+    $classCounts[$class] += 1
+}
+
+$updatedAt = Get-Date -Format "yyyy-MM-ddTHH:mm:sszzz"
+$summary = [ordered]@{
+    updated_at = $updatedAt
+    runs_started = $runCount
+    runs_shipped = $shippedRuns
+    failed_runs = $failedRuns
+    failures_total = $failures.Count
+    failures_open = $openFailures
+    regressions_added = $regressionsAdded
+    validation_evidence_rate_percent = $evidenceRate
+    average_minutes_start_to_ship = $averageMinutes
+    failure_classes = $classCounts
+}
+
+$classMarkdown = if ($classCounts.Count -gt 0) {
+    ($classCounts.GetEnumerator() | Sort-Object Name | ForEach-Object { "| {0} | {1} |" -f $_.Name, $_.Value }) -join "`r`n"
+}
+else {
+    "| none | 0 |"
+}
+
+$avgText = if ($null -eq $averageMinutes) { "n/a" } else { "$averageMinutes" }
+
+$markdown = @"
+# Agentic Workflow Metrics
+
+Last updated: $updatedAt
+
+| Metric | Value |
+|---|---:|
+| Runs started | $runCount |
+| Runs shipped/complete | $shippedRuns |
+| Runs with linked failures | $failedRuns |
+| Failure cases | $($failures.Count) |
+| Open failures | $openFailures |
+| Regressions added | $regressionsAdded |
+| Validation evidence rate | $evidenceRate% |
+| Avg minutes start to ship | $avgText |
+
+## Failure Classes
+
+| Class | Count |
+|---|---:|
+$classMarkdown
+"@
+
+$markdown | Set-Content -LiteralPath (Join-Path $metricsDir "summary.md") -Encoding UTF8
+($summary | ConvertTo-Json -Depth 8) | Set-Content -LiteralPath (Join-Path $metricsDir "summary.json") -Encoding UTF8
+
+if ($Json) {
+    $summary | ConvertTo-Json -Depth 8
+}
+else {
+    Write-Output $markdown
+}
+

