+[CmdletBinding()]
+param(
+    [Parameter(Mandatory = $true)]
+    [string]$Objective,
+
+    [string]$Repo = (Get-Location).Path,
+
+    [string]$Branch = "",
+
+    [ValidateSet("low", "medium", "high")]
+    [string]$RiskLevel = "medium",
+
+    [string[]]$ValidationPlan = @(),
+
+    [ValidateSet("windows", "wsl", "mac")]
+    [string]$Machine = "windows",
+
+    [string]$PromptSummary = "",
+
+    [string]$StatusPath = ""
+)
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = "Stop"
+
+function New-Slug {
+    param([Parameter(Mandatory = $true)][string]$Text)
+
+    $slug = [regex]::Replace($Text.ToLowerInvariant(), "[^a-z0-9]+", "-").Trim("-")
+    if ($slug.Length -gt 48) {
+        $slug = $slug.Substring(0, 48).Trim("-")
+    }
+    if ([string]::IsNullOrWhiteSpace($slug)) {
+        return "run"
+    }
+    return $slug
+}
+
+function Get-GitBranch {
+    param([Parameter(Mandatory = $true)][string]$RepoPath)
+
+    try {
+        $branchName = & git -C $RepoPath rev-parse --abbrev-ref HEAD 2>$null | Select-Object -First 1
+        if ($LASTEXITCODE -eq 0 -and -not [string]::IsNullOrWhiteSpace($branchName)) {
+            return $branchName.Trim()
+        }
+    }
+    catch {
+        return ""
+    }
+    return ""
+}
+
+function ConvertTo-RepoPath {
+    param([Parameter(Mandatory = $true)][string]$Path)
+
+    if (Test-Path -LiteralPath $Path) {
+        return (Resolve-Path -LiteralPath $Path).Path
+    }
+    return $Path
+}
+
+function Normalize-List {
+    param([string[]]$Items)
+
+    $normalized = @()
+    foreach ($item in @($Items)) {
+        if ($null -eq $item) {
+            continue
+        }
+        foreach ($part in ([string]$item -split ",")) {
+            $trimmed = $part.Trim()
+            if (-not [string]::IsNullOrWhiteSpace($trimmed)) {
+                $normalized += $trimmed
+            }
+        }
+    }
+    return $normalized
+}
+
+$scriptDir = Split-Path -Parent $PSCommandPath
+$root = Split-Path -Parent $scriptDir
+$runsDir = Join-Path $root "runs"
+$metricsDir = Join-Path $root "metrics"
+New-Item -ItemType Directory -Force -Path $runsDir, $metricsDir | Out-Null
+
+$repoPath = ConvertTo-RepoPath $Repo
+if ([string]::IsNullOrWhiteSpace($Branch)) {
+    $Branch = Get-GitBranch $repoPath
+}
+if ([string]::IsNullOrWhiteSpace($Branch)) {
+    $Branch = "unknown"
+}
+
+$createdAt = Get-Date -Format "yyyy-MM-ddTHH:mm:sszzz"
+$stamp = Get-Date -Format "yyyy-MM-dd_HHmm"
+$baseRunId = "{0}_{1}" -f $stamp, (New-Slug $Objective)
+$runId = $baseRunId
+$suffix = 2
+while (Test-Path -LiteralPath (Join-Path $runsDir $runId)) {
+    $runId = "{0}-{1}" -f $baseRunId, $suffix
+    $suffix += 1
+}
+
+$runDir = Join-Path $runsDir $runId
+New-Item -ItemType Directory -Force -Path $runDir | Out-Null
+
+$validationItems = @(Normalize-List $ValidationPlan)
+$validationMarkdown = if ($validationItems.Count -gt 0) {
+    ($validationItems | ForEach-Object { "- {0}" -f $_ }) -join "`r`n"
+}
+else {
+    "- TBD"
+}
+
+$repoName = Split-Path -Leaf $repoPath
+$runData = [ordered]@{
+    run_id = $runId
+    created_at = $createdAt
+    completed_at = $null
+    machine = $Machine
+    repo = $repoPath.Replace("\", "/")
+    repo_name = $repoName
+    branch = $Branch
+    worktree = $null
+    objective = $Objective
+    user_prompt_summary = $PromptSummary
+    status_path = $StatusPath
+    risk_level = $RiskLevel
+    status = "in_progress"
+    validation_plan = $validationItems
+    files_changed = @()
+    linked_failures = @()
+    evidence_links = @()
+    reviewer_result = $null
+    final_outcome = $null
+}
+
+($runData | ConvertTo-Json -Depth 8) | Set-Content -LiteralPath (Join-Path $runDir "run.json") -Encoding UTF8
+
+$taskMarkdown = @"
+# $runId
+
+## Objective
+$Objective
+
+## User Prompt Summary
+$PromptSummary
+
+## Repo
+- Machine: $Machine
+- Path: $repoPath
+- Branch/worktree: $Branch
+- Status path: $StatusPath
+- Risk level: $RiskLevel
+
+## Validation Plan
+$validationMarkdown
+"@
+$taskMarkdown | Set-Content -LiteralPath (Join-Path $runDir "task.md") -Encoding UTF8
+
+@"
+# Plan
+
+## Approach
+- TBD
+
+## Constraints
+- Preserve surrounding code style.
+- Keep the diff scoped to the stated objective.
+- Escalate product, API, data model, security, and irreversible decisions.
+
+## Validation
+$validationMarkdown
+"@ | Set-Content -LiteralPath (Join-Path $runDir "plan.md") -Encoding UTF8
+
+@"
+# Evidence
+
+## Commands
+| Command | Result | Notes |
+|---|---|---|
+
+## Proof
+- TBD
+
+## Artifacts
+- TBD
+"@ | Set-Content -LiteralPath (Join-Path $runDir "evidence.md") -Encoding UTF8
+
+@"
+# Review
+
+## Independent Reviewer
+
+## Must-fix
+- TBD
+
+## Should-fix / Nits
+- TBD
+
+## Resolution
+- TBD
+"@ | Set-Content -LiteralPath (Join-Path $runDir "review.md") -Encoding UTF8
+
+@"
+# Final
+
+## Outcome
+TBD
+
+## What Changed
+- TBD
+
+## Validation
+- TBD
+
+## Risks
+- TBD
+
+## Follow-ups
+- TBD
+"@ | Set-Content -LiteralPath (Join-Path $runDir "final.md") -Encoding UTF8
+
+New-Item -ItemType File -Force -Path (Join-Path $runDir "commands.jsonl") | Out-Null
+New-Item -ItemType File -Force -Path (Join-Path $runDir "diff.patch") | Out-Null
+
+$event = [ordered]@{
+    type = "run_started"
+    at = $createdAt
+    run_id = $runId
+    repo = $repoPath.Replace("\", "/")
+    objective = $Objective
+    risk_level = $RiskLevel
+}
+$eventLine = $event | ConvertTo-Json -Compress -Depth 5
